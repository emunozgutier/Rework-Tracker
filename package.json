{
  "name": "rework-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/store/serverDataBase/server.ts\" \"vite\"",
    "dev:sandbox": "concurrently \"DB_PATH=src/store/serverDataBase/data/pcb_tracker_sandbox.db UPLOAD_DIR=src/store/serverDataBase/data/sandbox_uploads tsx watch src/store/serverDataBase/server.ts\" \"vite\"",
    "dev:caddy": "concurrently \"tsx watch src/store/serverDataBase/server.ts\" \"vite --base=/RT/\"",
    "db:clean-test": "tsx scripts/cleanTestData.ts",
    "db:seed": "tsx scripts/seedDemoData.ts",
    "db:reset-sandbox": "tsx scripts/resetSandbox.ts",
    "diag:5001": "python3 diagnose_5001.py",
    "build": "tsc -b && vite build && node copy-404.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:run": "NODE_ENV=test vitest --run --environment jsdom --fileParallelism=false",
    "test": "start-server-and-test 'NODE_ENV=test tsx src/store/serverDataBase/server.ts' http-get://localhost:5002/api/dashboard test:run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.7.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-qr-code": "^2.0.18",
    "sqlite3": "^6.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.1",
    "@types/babel__core": "^7.20.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "start-server-and-test": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
